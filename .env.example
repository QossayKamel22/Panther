# PANTHER environment configuration
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Anthropic API key. When unset, PANTHER runs in demo mode with clearly
# labeled mock responses instead of failing.
ANTHROPIC_API_KEY=

# Optional: override the default model used by the Anthropic provider.
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Placeholders for future integrations (see docs/ROADMAP.md, Phase 4).
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
